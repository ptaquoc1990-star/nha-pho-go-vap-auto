# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Meta for Developers > App settings > Basic
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Must exactly match the Valid OAuth Redirect URI configured in Meta
META_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# Use a long random string in production
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
APP_BASE_URL=http://localhost:3000
